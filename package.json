{
  "name": "facts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FACTS: Financial Analysis & Control Tracking System for Gilbert L. Sena Charter High School",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:bar": "vite --mode bar-builder",
    "build:bar": "vite build --mode bar-builder --outDir dist-bar-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{js,css}\" \"test/**/*.js\" index.html",
    "dev:jem": "vite --mode jem",
    "build:jem": "vite build --mode jem --outDir dist-jem"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "prettier": "^3.3.0"
  }
}
